{
  "task": "navigate_to_goal_with_obstacle_avoidance",
  "skills": [
    {
      "order": 1,
      "name": "perceive_goal_state",
      "type": "perception",
      "description": "Monitor relative goal position and distance.",
      "inputs": [
        {"key": "goal_rel", "score": 0.6},
        {"key": "dist", "score": 0.4}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "always",
      "objective": "Continuously track goal direction and proximity."
    },
    {
      "order": 2,
      "name": "perceive_obstacle_state",
      "type": "perception",
      "description": "Monitor nearest obstacle distance and relative position.",
      "inputs": [
        {"key": "dist_norm", "score": 0.7},
        {"key": "goal_rel", "score": 0.3}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "always",
      "objective": "Maintain awareness of nearby obstacles."
    },
    {
      "order": 3,
      "name": "evaluate_motion_alignment",
      "type": "planning",
      "description": "Evaluate alignment between velocity and goal direction.",
      "inputs": [
        {"key": "alignment", "score": 0.6},
        {"key": "vel_norm", "score": 0.4}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "always",
      "objective": "Determine if motion correction is required."
    },
    {
      "order": 4,
      "name": "stabilize_orientation",
      "type": "control",
      "description": "Correct unstable roll and pitch angles.",
      "inputs": [
        {"key": "rp", "score": 0.7},
        {"key": "ang_vel_norm", "score": 0.3}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "abs(rp[0]) > 0.2 or abs(rp[1]) > 0.2",
      "objective": "Maintain stable flight dynamics."
    },
    {
      "order": 5,
      "name": "emergency_obstacle_avoidance",
      "type": "control",
      "description": "Perform rapid avoidance when obstacle is very close.",
      "inputs": [
        {"key": "dist_norm", "score": 0.6},
        {"key": "vel_norm", "score": 0.4}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "dist_norm < 0.15",
      "objective": "Avoid imminent collision by immediate maneuver."
    },
    {
      "order": 6,
      "name": "preventive_obstacle_avoidance",
      "type": "control",
      "description": "Adjust trajectory when approaching an obstacle.",
      "inputs": [
        {"key": "dist_norm", "score": 0.6},
        {"key": "alignment", "score": 0.4}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "dist_norm < 0.3 and dist_norm >= 0.15",
      "objective": "Gradually steer away from obstacles."
    },
    {
      "order": 7,
      "name": "realign_heading_to_goal",
      "type": "control",
      "description": "Adjust yaw and velocity direction toward the goal.",
      "inputs": [
        {"key": "alignment", "score": 0.5},
        {"key": "goal_rel", "score": 0.5}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "alignment < 0.8 and dist > 0.1",
      "objective": "Improve heading alignment toward goal."
    },
    {
      "order": 8,
      "name": "cruise_to_goal",
      "type": "control",
      "description": "Move efficiently toward the goal when aligned and safe.",
      "inputs": [
        {"key": "goal_rel", "score": 0.4},
        {"key": "alignment", "score": 0.3},
        {"key": "dist", "score": 0.3}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "alignment >= 0.9 and dist >= 0.1 and dist_norm >= 0.3",
      "objective": "Maximize forward progress toward goal."
    },
    {
      "order": 9,
      "name": "slow_approach_goal",
      "type": "control",
      "description": "Reduce velocity and stabilize near the goal.",
      "inputs": [
        {"key": "dist", "score": 0.6},
        {"key": "vel_norm", "score": 0.4}
      ],
      "outputs": [
        {"key": "vx"},
        {"key": "vy"},
        {"key": "vz"},
        {"key": "ω_z"}
      ],
      "trigger": "dist < 0.1",
      "objective": "Ensure precise arrival without overshooting."
    }
  ]
}